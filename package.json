{
  "name": "lift-journal",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.22",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-isolation=none --test-reporter=spec tests/*.test.mjs",
    "export:ios": "expo export --platform ios",
    "build:web": "expo export --platform web && node scripts/prepare-web.mjs",
    "serve:web": "python3 -m http.server 8081 --directory dist --bind 0.0.0.0",
    "test:web": "playwright test"
  },
  "private": true
}
