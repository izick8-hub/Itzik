{
  "name": "together-cart",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build && node scripts/prepare-static.mjs",
    "start": "python3 -m http.server 3000 --directory out --bind 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-isolation=none --test-reporter=spec tests/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/heebo": "^5.3.0",
    "@supabase/supabase-js": "^2.80.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  }
}
